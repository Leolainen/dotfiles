#!/usr/bin/env zsh

# init antidote plugin manager
# Homebrew (macOS) first, then Linux install locations
if (( $+commands[brew] )); then
  export BREW_HOME=$(brew --prefix)
  export ANTIDOTE_HOME="$BREW_HOME/opt/antidote/share/antidote"
elif [[ -d "$HOME/.antidote" ]]; then
  export ANTIDOTE_HOME="$HOME/.antidote"
elif [[ -d /usr/share/zsh-antidote ]]; then
  export ANTIDOTE_HOME=/usr/share/zsh-antidote
fi

[[ -r $ANTIDOTE_HOME/antidote.zsh ]] && source $ANTIDOTE_HOME/antidote.zsh

zsh_plugins=~/.zsh_plugins.zsh

export NVM_LAZY_LOAD=true
export NVM_COMPLETION=true

bindkey '^[[A' history-substring-search-up;
bindkey '^[[B' history-substring-search-down;

ZSH_AUTOSUGGEST_PARTIAL_ACCEPT_WIDGETS=(forward-word forward-char)
ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=(end-of-line)

(( $+functions[antidote] )) && antidote load ~/.zsh_plugins.txt
