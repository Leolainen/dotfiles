#!/usr/bin/env zsh

# --- Moving around ---
alias ..="cd .."
alias ...="cd ../.."
alias cd..="cd .."
if [[ $OSTYPE == darwin* ]]; then
  alias oo='open .'
else
  alias oo='xdg-open .'
fi

# --- Shortcust ---
alias dot='cd ${DOTFILES:-$HOME/dotfiles}'
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias atg="cd ~/ATG"

# --- Docker ---
alias dc='docker-compose'


# --- utils ---
if (( $+commands[ifconfig] )); then
  alias getip='ifconfig | grep 192'
else
  alias getip='ip -4 addr | grep 192'
fi
alias getssh='cat ~/.ssh/id_ed25519.pub'
alias unixTime='date +%s'
[[ $OSTYPE == darwin* ]] && alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome'

# better ls
# alias ls='pwd; ls -color'
if (( $+commands[colorls] )); then
  alias ls='colorls'
  alias la='colorls -a'
  alias l='colorls -al'
  alias ll='colorls -l'
fi

# npm
alias flush-npm="rm -rf node_modules && npm i && echo NPM is done"
alias flush-yarn="rm -rf node_modules && yarn && echo Yarn is done"

# git
alias status="git status"
alias amend="git commit --amend"
alias logf='git log --date-order --all --graph --format="%C(green)%h%Creset %C(yellow)%an%Creset %C(blue bold)%ar%Creset %C(red bold)%d%Creset%s"'
alias logs='git log --date-order --all --graph --name-status --format="%C(green)%h%Creset %C(yellow)%an%Creset %C(blue bold)%ar%Creset %C(red bold)%d%Creset%s"'
alias loga='git log --graph --decorate --pretty=oneline --abbrev-commit --all'
alias logd='git log --graph --decorate --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset --abbrev-commit --date=relative --all"'

# Togglers
if [[ $OSTYPE == darwin* ]]; then
  alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
  alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
  alias mouseAccOff="defaults write .GlobalPreferences com.apple.mouse.scaling -1"
  alias mouseAccOff2="defaults write com.apple.mouse.scaling 2.0"
  alias mouseAccOn="defaults write .GlobalPreferences com.apple.mouse.scaling 1"
fi

alias refresh="source ~/.zshrc"

# php
[[ -f /usr/local/bin/composer.phar ]] && alias composer="php /usr/local/bin/composer.phar"

# lunarvim
[[ -x "$HOME/.local/bin/lvim" ]] && alias lvim="$HOME/.local/bin/lvim"
alias vim="nvim"

# docker
[[ -x "$HOME/.docker/bin/docker" ]] && alias docker="$HOME/.docker/bin/docker"
