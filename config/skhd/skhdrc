# SHORTCUT CHEAT SHEET
# Window focus: ctrl + alt + h/j/k/l
# Swap windows: shift + ctrl + alt + h/j/k/l
# Resize: ctrl + alt + arrow keys
# Layout: ctrl + alt + f float, m maximize, r rotate, x/y mirror, 0 balance
# Spaces: ctrl + alt + 1-9 focus, shift + ctrl + alt + 1-9 move window
# Displays: ctrl + alt + w/e/q focus, shift + ctrl + alt + w/e move window
# Apps: s Slack, t Terminal, b Browser, o Obsidian, i System Settings
#       d Dev-agent app (Herdr), p Player (Spotify), g Figma, n Teams, u Outlook
# Reload Yabai: shift + ctrl + alt + r
# ctrl + alt + space opens the floating shortcut sheet

# -- Window Focus --

# Hold ctrl + alt as the window-management leader.
ctrl + alt - h : yabai -m window --focus west; sketchybar --trigger window_focus
ctrl + alt - j : yabai -m window --focus south; sketchybar --trigger window_focus
ctrl + alt - k : yabai -m window --focus north; sketchybar --trigger window_focus
ctrl + alt - l : yabai -m window --focus east; sketchybar --trigger window_focus

# -- Move and Resize Windows --

shift + ctrl + alt - h : yabai -m window --swap west; sketchybar --trigger window_focus
shift + ctrl + alt - j : yabai -m window --swap south; sketchybar --trigger window_focus
shift + ctrl + alt - k : yabai -m window --swap north; sketchybar --trigger window_focus
shift + ctrl + alt - l : yabai -m window --swap east; sketchybar --trigger window_focus

ctrl + alt - left : yabai -m window west --resize right:-20:0 2> /dev/null || yabai -m window --resize right:-20:0
ctrl + alt - down : yabai -m window north --resize bottom:0:20 2> /dev/null || yabai -m window --resize bottom:0:20
ctrl + alt - up : yabai -m window south --resize top:0:-20 2> /dev/null || yabai -m window --resize top:0:-20
ctrl + alt - right : yabai -m window east --resize left:20:0 2> /dev/null || yabai -m window --resize left:20:0

# -- Layout --

ctrl + alt - r : yabai -m space --rotate 270
ctrl + alt - y : yabai -m space --mirror y-axis
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - f : yabai -m window --toggle float --grid 12:12:2:1:8:10
ctrl + alt - m : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus
ctrl + alt - c : "$HOME/.config/yabai/toggle_window_ratio.sh"
ctrl + alt - 0 : yabai -m space --balance

# -- Spaces and Displays --

ctrl + alt - 1 : yabai -m space --focus 1; sketchybar --trigger window_focus
ctrl + alt - 2 : yabai -m space --focus 2; sketchybar --trigger window_focus
ctrl + alt - 3 : yabai -m space --focus 3; sketchybar --trigger window_focus
ctrl + alt - 4 : yabai -m space --focus 4; sketchybar --trigger window_focus
ctrl + alt - 5 : yabai -m space --focus 5; sketchybar --trigger window_focus
ctrl + alt - 6 : yabai -m space --focus 6; sketchybar --trigger window_focus
ctrl + alt - 7 : yabai -m space --focus 7; sketchybar --trigger window_focus
ctrl + alt - 8 : yabai -m space --focus 8; sketchybar --trigger window_focus
ctrl + alt - 9 : yabai -m space --focus 9; sketchybar --trigger window_focus

shift + ctrl + alt - 1 : yabai -m window --space 1; sketchybar --trigger window_focus
shift + ctrl + alt - 2 : yabai -m window --space 2; sketchybar --trigger window_focus
shift + ctrl + alt - 3 : yabai -m window --space 3; sketchybar --trigger window_focus
shift + ctrl + alt - 4 : yabai -m window --space 4; sketchybar --trigger window_focus
shift + ctrl + alt - 5 : yabai -m window --space 5; sketchybar --trigger window_focus
shift + ctrl + alt - 6 : yabai -m window --space 6; sketchybar --trigger window_focus
shift + ctrl + alt - 7 : yabai -m window --space 7; sketchybar --trigger window_focus
shift + ctrl + alt - 8 : yabai -m window --space 8; sketchybar --trigger window_focus
shift + ctrl + alt - 9 : yabai -m window --space 9; sketchybar --trigger window_focus

ctrl + alt - w : yabai -m display --focus next; sketchybar --trigger window_focus
ctrl + alt - e : yabai -m display --focus prev; sketchybar --trigger window_focus
ctrl + alt - q : yabai -m display --focus recent; sketchybar --trigger window_focus
shift + ctrl + alt - w : yabai -m window --display next --focus; sketchybar --trigger window_focus
shift + ctrl + alt - e : yabai -m window --display prev --focus; sketchybar --trigger window_focus
shift + ctrl + alt - left : yabai -m window --space prev --focus; sketchybar --trigger window_focus
shift + ctrl + alt - right : yabai -m window --space next --focus; sketchybar --trigger window_focus

# -- Apps --

ctrl + alt - s : open -a Slack
ctrl + alt - t : open -a Ghostty
shift + ctrl + alt - t : osascript -e 'tell application "Ghostty" to activate' -e 'tell application "Ghostty" to new window'
ctrl + alt - b : open -a "Google Chrome"
ctrl + alt - o : open -a Obsidian
ctrl + alt - i : open -a "System Settings"
ctrl + alt - d : open -a Herdr
ctrl + alt - p : open -b com.spotify.client
ctrl + alt - g : open -b com.figma.Desktop
ctrl + alt - n : open -a "Microsoft Teams"
ctrl + alt - u : open -a "Microsoft Outlook"

# -- Help and Services --

ctrl + alt - space : if pgrep -f '/dotfiles-shortcut-sheet$' >/dev/null; then pkill -TERM -f '/dotfiles-shortcut-sheet$'; else "$HOME/.local/bin/dotfiles-shortcut-sheet" >/dev/null 2>&1 & fi
shift + ctrl + alt - space : if pgrep -f '/dotfiles-theme-picker$' >/dev/null; then pkill -TERM -f '/dotfiles-theme-picker$'; else "$HOME/.local/bin/dotfiles-theme-picker" >/dev/null 2>&1 & fi
shift + ctrl + alt - backspace : /bin/zsh -c 'rc="$HOME/.config/skhd/skhdrc"; exec "${rc:A:h}/reload_desktop.sh"'
shift + ctrl + alt - q : yabai --stop-service
shift + ctrl + alt - s : yabai --start-service
shift + ctrl + alt - r : yabai --restart-service || yabai --start-service
