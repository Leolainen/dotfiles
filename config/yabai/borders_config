#!/bin/bash

# Yabai dropped border support
# This uses jankyborders
# https://github.com/FelixKratz/JankyBorders

source "$HOME/.config/sketchybar/palette.sh"

SILVER="${palette[7]}"
GREY="${palette[8]}"
BORDER="${GREY}"
BORDER_HIGHLIGHT="$SILVER"

if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/palette.sh" ]; then
    source "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/palette.sh"
fi

rounded=(
    order=above
    style=round
    width=1.0
    hidpi=on
)

squared=(
    hidpi=off
    order=above
    width=8.0
    style=square

)

theme=(
    active_color=$BORDER_HIGHLIGHT
    inactive_color=$BORDER
    background_color=$background
)

options=(
    ${rounded[@]}
    ${theme[@]}
)

# borders "${options[@]}"
